CREATE TABLE orders ( 
    order_id INT PRIMARY KEY, 
    customer_id INT, 
    order_date DATE, 
    total_amount DECIMAL(10,2), 
    -- If a customer account is deleted, keep the order but set customer_id to NULL (Guest order) 
    CONSTRAINT _order_customer FOREIGN KEY (customer_id) REFERENCES customers(customer_id) 
ON DELETE SET NULL 
);

