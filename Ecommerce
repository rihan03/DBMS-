12. Find the "Power Shoppers". List the first_name of customers who have purchased a grand total of more than 1 physical item across all their lifeme orders. 

select c.first_name, sum(oi.quantity) as total_items 
from customers c 
join orders o
on c.customer_id = o.customer_id
join order_items oi 
on o.order_id = oi.order_id
group by c.customer_id, c.first_name
having sum(oi.quantity) > 1 ; 

